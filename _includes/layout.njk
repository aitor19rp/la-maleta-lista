{%- set ogFoto = imagen_cabecera or "/img/hero-viajes.jpg" -%}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.nombre }}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  <meta name="theme-color" content="#1B4B66">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="{{ site.nombre }}">
  <meta property="og:title" content="{{ title or site.nombre }}">
  <meta property="og:description" content="{{ descripcion or site.descripcion }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{% imagenCompartir ogFoto %}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/logo/icono.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/style.css?v={{ cssVersion }}">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#contenido" class="saltar">Saltar al contenido</a>

  <header class="site-header">
    <a href="/" class="logo-link">
      <img src="/logo/horizontal-recortado.png" alt="{{ site.nombre }}" class="logo-horizontal" width="150" height="30">
    </a>
  </header>

  <main id="contenido">
    {{ content | safe }}
  </main>

  <section class="redes">
    <a href="{{ site.redes.tiktok }}" class="boton-red" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82c-.9-.78-1.46-1.9-1.6-3.14h-3.14v13.4a3.16 3.16 0 1 1-2.24-3.03V9.7a6.3 6.3 0 1 0 5.38 6.24V9.06a8.4 8.4 0 0 0 4.9 1.56V7.5a5.1 5.1 0 0 1-3.3-1.68z"/></svg>
      TikTok<span class="solo-lectores"> (se abre en una pestaña nueva)</span>
    </a>
  </section>

  <section class="telegram-cta">
    <h2>Recibe los chollos antes que en las redes</h2>
    <p>Canal gratis de Telegram: te aviso con precio y fechas comprobados en cuanto sale una oferta, antes de subirla a las redes.</p>
    {% set canalClase = 'boton-cta' %}{% set canalTexto = 'Recibe los chollos antes que en redes' %}{% set canalTg = (site.telegramInvitacion.portada if page.url == '/' else (site.telegramInvitacion.guia if '/guia/' in page.url else site.telegramInvitacion.ficha)) %}{% include 'boton-telegram.njk' %}
  </section>

  <footer class="site-footer">
    <p>&copy; {% anioActual %} {{ site.nombre }}</p>
  </footer>

  {% if site.gaId or site.clarityId %}

  <div class="cookies" id="cookies" role="dialog" aria-labelledby="cookies-titulo" hidden>
    <p id="cookies-titulo"><strong>¿Aceptas las cookies de analítica?</strong></p>
    <p>Las uso para saber qué ofertas se visitan más. Si las rechazas, la web funciona igual.</p>
    <div class="cookies-botones">
      <button type="button" class="btn btn-coral" id="cookies-si">Aceptar</button>
      <button type="button" class="btn btn-borde" id="cookies-no">Rechazar</button>
    </div>
  </div>
  <script>
  (function () {
    var clave = 'cookies-analitica';
    var guardado = null;
    try { guardado = localStorage.getItem(clave); } catch (e) {}

    function cargarAnalitica() {
      {% if site.gaId %}
      var g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}';
      document.head.appendChild(g);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', '{{ site.gaId }}');
      {% endif %}
      {% if site.clarityId %}
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', '{{ site.clarityId }}');
      {% endif %}
    }

    function decidir(acepta) {
      try { localStorage.setItem(clave, acepta ? 'si' : 'no'); } catch (e) {}
      document.getElementById('cookies').hidden = true;
      if (acepta) cargarAnalitica();
    }

    // Clic en un enlace de afiliado. Solo se envía si la analítica está cargada (cookies aceptadas).
    document.addEventListener('click', function (e) {
      var a = e.target.closest ? e.target.closest('a[rel~="sponsored"]') : null;
      if (!a || typeof window.gtag !== 'function') return;
      var host = '';
      try { host = new URL(a.href).hostname; } catch (err) {}
      var proveedor = host;
      if (/pxf\.io|skyscanner/.test(host)) proveedor = 'skyscanner';
      else if (/trivago|tradetracker|ttrk|tt\d*\.|trvg/.test(host)) proveedor = 'trivago';
      else if (/awin1/.test(host)) proveedor = 'awin';
      var posicion = (a.className || '').replace(/\bbtn(-\w+)?\b/g, '').trim().split(/\s+/)[0] || 'enlace';
      var oferta = location.pathname.replace(/^\/+|\/+$/g, '').replace(/^ofertas\//, '') || 'portada';
      gtag('event', 'affiliate_click', { provider: proveedor, offer_id: oferta, button_position: posicion, link_domain: host });
    }, true);

    if (guardado === 'si') { cargarAnalitica(); return; }
    if (guardado === 'no') return;
    document.getElementById('cookies').hidden = false;
    document.getElementById('cookies-si').addEventListener('click', function () { decidir(true); });
    document.getElementById('cookies-no').addEventListener('click', function () { decidir(false); });
  })();
  </script>
  {% endif %}
</body>
</html>
