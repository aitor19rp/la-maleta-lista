{%- set ogFoto = imagen_cabecera or "/img/hero-viajes.jpg" -%}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.nombre }}</title>
  <meta name="description" content="{{ descripcion or site.descripcion }}">
  <meta name="theme-color" content="#1B4B66">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">
  <meta property="og:site_name" content="{{ site.nombre }}">
  <meta property="og:title" content="{{ title or site.nombre }}">
  <meta property="og:description" content="{{ descripcion or site.descripcion }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{% imagenCompartir ogFoto %}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/logo/icono.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/style.css?v={{ cssVersion }}">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a href="#contenido" class="saltar">Saltar al contenido</a>

  <div class="popup-tg" id="popup-tg" role="dialog" aria-modal="true" aria-labelledby="popup-tg-titulo" hidden>
    <div class="popup-tg-caja">
      <button type="button" class="popup-tg-cerrar" id="popup-tg-cerrar" aria-label="Cerrar">&times;</button>
      <p class="popup-tg-emoji" aria-hidden="true">🚨</p>
      <h2 id="popup-tg-titulo">No te pierdas el próximo chollo</h2>
      <p>Te aviso por Telegram en cuanto sale una oferta, con el precio y las fechas comprobados. Gratis y sin spam.</p>
      {% set canalClase = 'btn btn-coral popup-tg-boton' %}{% set canalTexto = 'Unirme al canal' %}{% set canalTg = site.telegramInvitacion.popup or site.telegramInvitacion.banner or site.telegramInvitacion.portada %}{% include 'boton-telegram.njk' %}
      <button type="button" class="popup-tg-luego" id="popup-tg-luego">Ahora no</button>
    </div>
  </div>
  <script>
  (function () {
    var p = document.getElementById('popup-tg');
    var clave = 'popup-tg';
    var DIAS = 86400000;
    function recordar(dias) { try { localStorage.setItem(clave, String(Date.now() + dias * DIAS)); } catch (e) {} }
    try { var hasta = Number(localStorage.getItem(clave)); if (hasta && Date.now() < hasta) return; } catch (e) {}

    var abierto = false, previo = null;
    function cerrar(dias) {
      p.hidden = true; abierto = false; recordar(dias);
      document.removeEventListener('keydown', teclas);
      if (previo && previo.focus) previo.focus();
    }
    function teclas(e) { if (e.key === 'Escape') cerrar(7); }
    function abrir() {
      if (abierto) return;
      var c = document.getElementById('cookies');
      if (c && !c.hidden) return; // no se apila sobre el aviso de cookies
      abierto = true; previo = document.activeElement;
      p.hidden = false;
      document.addEventListener('keydown', teclas);
      var enlace = p.querySelector('.popup-tg-boton'); if (enlace) enlace.focus();
    }
    p.addEventListener('click', function (e) { if (e.target === p) cerrar(7); });
    document.getElementById('popup-tg-cerrar').addEventListener('click', function () { cerrar(7); });
    document.getElementById('popup-tg-luego').addEventListener('click', function () { cerrar(7); });
    p.querySelector('.popup-tg-boton').addEventListener('click', function () { recordar(90); p.hidden = true; abierto = false; document.removeEventListener('keydown', teclas); });

    // Aparece a los 15 s o al bajar un poco la página (lo primero que pase), nunca nada más entrar.
    var inicio = Date.now();
    var reloj = setInterval(function () {
      var scroll = (window.scrollY || 0) > 400;
      if (Date.now() - inicio > 15000 || (scroll && Date.now() - inicio > 6000)) {
        abrir();
        if (abierto) clearInterval(reloj);
      }
    }, 1000);
  })();
  </script>

  <header class="site-header">
    <a href="/" class="logo-link">
      <img src="/logo/horizontal-recortado.png" alt="{{ site.nombre }}" class="logo-horizontal" width="150" height="30">
    </a>
  </header>

  <main id="contenido">
    {{ content | safe }}
  </main>

  <section class="redes">
    <a href="{{ site.redes.tiktok }}" class="boton-red" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82c-.9-.78-1.46-1.9-1.6-3.14h-3.14v13.4a3.16 3.16 0 1 1-2.24-3.03V9.7a6.3 6.3 0 1 0 5.38 6.24V9.06a8.4 8.4 0 0 0 4.9 1.56V7.5a5.1 5.1 0 0 1-3.3-1.68z"/></svg>
      TikTok<span class="solo-lectores"> (se abre en una pestaña nueva)</span>
    </a>
  </section>

  <section class="telegram-cta">
    <h2>Sé el primero en enterarte de los chollos</h2>
    <p>Únete a nuestro canal gratis de Telegram: te aviso con precio y fechas comprobados en cuanto sale una oferta.</p>
    {% set canalClase = 'boton-cta' %}{% set canalTexto = 'Únete al canal y no te pierdas ningún chollo' %}{% set canalTg = (site.telegramInvitacion.portada if page.url == '/' else (site.telegramInvitacion.guia if '/guia/' in page.url else site.telegramInvitacion.ficha)) %}{% include 'boton-telegram.njk' %}
    <p class="cta-youtube">¿Prefieres vídeo? <a href="{{ site.redes.youtube }}" target="_blank" rel="noopener">Mira el canal de YouTube<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a></p>
  </section>

  <footer class="site-footer">
    <p>&copy; {% anioActual %} {{ site.nombre }}</p>
  </footer>

  {% if site.gaId or site.clarityId %}

  <div class="cookies" id="cookies" role="dialog" aria-labelledby="cookies-titulo" hidden>
    <p id="cookies-titulo"><strong>¿Aceptas las cookies de analítica?</strong></p>
    <p>Las uso para saber qué ofertas se visitan más. Si las rechazas, la web funciona igual.</p>
    <div class="cookies-botones">
      <button type="button" class="btn btn-coral" id="cookies-si">Aceptar</button>
      <button type="button" class="btn btn-borde" id="cookies-no">Rechazar</button>
    </div>
  </div>
  <script>
  (function () {
    var clave = 'cookies-analitica';
    var guardado = null;
    try { guardado = localStorage.getItem(clave); } catch (e) {}

    function cargarAnalitica() {
      {% if site.gaId %}
      var g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}';
      document.head.appendChild(g);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', '{{ site.gaId }}');
      {% endif %}
      {% if site.clarityId %}
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', '{{ site.clarityId }}');
      {% endif %}
    }

    function decidir(acepta) {
      try { localStorage.setItem(clave, acepta ? 'si' : 'no'); } catch (e) {}
      document.getElementById('cookies').hidden = true;
      if (acepta) cargarAnalitica();
    }

    // Clic en un enlace de afiliado. Solo se envía si la analítica está cargada (cookies aceptadas).
    document.addEventListener('click', function (e) {
      var a = e.target.closest ? e.target.closest('a[rel~="sponsored"]') : null;
      if (!a || typeof window.gtag !== 'function') return;
      var host = '';
      try { host = new URL(a.href).hostname; } catch (err) {}
      var proveedor = host;
      if (/pxf\.io|skyscanner/.test(host)) proveedor = 'skyscanner';
      else if (/trivago|tradetracker|ttrk|tt\d*\.|trvg/.test(host)) proveedor = 'trivago';
      else if (/awin1/.test(host)) proveedor = 'awin';
      var posicion = (a.className || '').replace(/\bbtn(-\w+)?\b/g, '').trim().split(/\s+/)[0] || 'enlace';
      var oferta = location.pathname.replace(/^\/+|\/+$/g, '').replace(/^ofertas\//, '') || 'portada';
      gtag('event', 'affiliate_click', { provider: proveedor, offer_id: oferta, button_position: posicion, link_domain: host });
    }, true);

    if (guardado === 'si') { cargarAnalitica(); return; }
    if (guardado === 'no') return;
    document.getElementById('cookies').hidden = false;
    document.getElementById('cookies-si').addEventListener('click', function () { decidir(true); });
    document.getElementById('cookies-no').addEventListener('click', function () { decidir(false); });
  })();
  </script>
  {% endif %}
</body>
</html>
