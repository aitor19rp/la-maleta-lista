---
layout: layout.njk
bodyClass: home pagina-oferta
eleventyComputed:
  descripcion: "{{ destino }}{% if subtitulo %} · {{ subtitulo }}{% endif %}: oferta publicada el {{ precio_verificado }}. Mira fechas, precio y cómo reservar."
  title: "Chollo a {{ destino }}{% if subtitulo %} · {{ subtitulo }}{% endif %} | La Maleta Lista"
---
{% set validas = opciones | opcionesValidas %}
{% set barata = validas | masBarata %}
{% set precio_barra = barata or (validas | first) %}
{% set conLink = validas | selectattr("link") %}
{% set conHotel = validas | selectattr("link_hotel") %}
{% set enlace = link_afiliado | clickrefLink(destino) %}
{% set hotelBase = link_hotel or (link_afiliado if (tipo == "hotel") else "") %}
{% set esHotel = (tipo == "hotel") or (not tipo and validas.length and ("Hotel" in (validas | first).salida)) %}
{% set meses_nombres = [["ene","Ene"],["feb","Feb"],["mar","Mar"],["abr","Abr"],["may","May"],["jun","Jun"],["jul","Jul"],["ago","Ago"],["sep","Sep"],["oct","Oct"],["nov","Nov"],["dic","Dic"]] %}

<article class="of"{% if caduca %} data-caduca="{{ caduca }}"{% endif %}>
  <header class="of-portada" style="view-transition-name: foto-{{ page.fileSlug }};">
    {% imagen imagen_cabecera, "Foto de " + destino, "(min-width: 720px) 720px, 100vw", [640, 1280], true %}
    <a href="/" class="of-btn-icono of-volver" aria-label="Volver al inicio">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </a>
    <a href="/" class="of-logo"><img src="/logo/horizontal-blanco.png" alt="La Maleta Lista, inicio" width="131" height="26"></a>
    <button type="button" class="of-btn-icono of-compartir" id="compartir" aria-label="Compartir esta oferta" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4M5 12v7h14v-7"/></svg>
    </button>
    <span class="of-estado" id="compartir-estado" role="status" aria-live="polite"></span>
    <div class="of-titulo">
      <h1>{{ destino }}</h1>
      {% if subtitulo %}<p>{{ subtitulo }}</p>{% endif %}
    </div>
  </header>

  <div class="of-cuerpo">
    {% if galeria and galeria.length %}
    <section aria-labelledby="of-fotos">
      <h2 id="of-fotos" class="solo-lectores">Fotos</h2>
      <div class="of-galeria-caja">
        <ul class="of-galeria">
          {% for foto in galeria %}
          <li><button type="button" class="of-foto" data-grande="{{ foto }}" aria-label="Ampliar la foto {{ loop.index }} de {{ galeria.length }}">{% imagen foto, "Foto " + loop.index + " de " + destino, "160px", [160, 320], false %}</button></li>
          {% endfor %}
        </ul>
        <button type="button" class="of-gal-flecha of-gal-ant" id="gal-ant" aria-label="Fotos anteriores" hidden>&lsaquo;</button>
        <button type="button" class="of-gal-flecha of-gal-sig" id="gal-sig" aria-label="Más fotos" hidden>&rsaquo;</button>
      </div>
    </section>
    <dialog class="of-visor" id="visor" aria-label="Fotos de {{ destino }}">
      <img src="" alt="" id="visor-img">
      <button type="button" class="of-visor-btn of-visor-cerrar" id="visor-cerrar" aria-label="Cerrar">&times;</button>
      <button type="button" class="of-visor-btn of-visor-ant" id="visor-ant" aria-label="Foto anterior">&lsaquo;</button>
      <button type="button" class="of-visor-btn of-visor-sig" id="visor-sig" aria-label="Foto siguiente">&rsaquo;</button>
    </dialog>
    {% endif %}

    <p class="of-publicado" data-fecha="{{ page.date.toISOString() | truncate(10, true, '') }}">Publicado el {{ precio_verificado }}<b class="hace"></b></p>

    {% if etiquetas %}
    <ul class="of-etiquetas" aria-label="A destacar">
      {% for e in etiquetas %}<li>{{ e }}</li>{% endfor %}
    </ul>
    {% endif %}


    {% set mes_salida = mes or ((validas | first).fecha | mesSalida if validas.length else "") %}
    {% if mes_salida %}
    <section aria-labelledby="of-meses">
      <h2 id="of-meses">{% if esHotel %}Mes de la estancia{% else %}Mes de salida{% endif %}</h2>
      <ul class="of-meses">
        {% for m in meses_nombres %}
        <li{% if m[0] == mes_salida %} class="activo"{% endif %}>{{ m[1] }}{% if m[0] == mes_salida %}<span class="solo-lectores"> ({% if esHotel %}mes de la estancia{% else %}mes de salida{% endif %})</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <p class="of-finalizada" id="of-finalizada" role="status" hidden><strong>Esta oferta ya ha finalizado.</strong> Las fechas han pasado. Mira los chollos activos en la <a href="/">portada</a> o únete a Telegram para el próximo.</p>

    <section aria-labelledby="of-fechas">
      <h2 id="of-fechas">Fechas y precios</h2>
      {% if validas.length %}
      <ul class="of-fechas">
        {% for opcion in validas %}
        <li{% if opcion == barata and validas.length > 1 %} class="barata"{% endif %}>
          <span class="of-fecha-datos">
            {% if esHotel %}
            <span class="of-fecha-fecha">{{ opcion.fecha }}</span>
            <span class="of-fecha-salida">{{ opcion.salida }}{% if opcion.nota %} · {{ opcion.nota }}{% endif %}</span>
            {% else %}
            <span class="of-fecha-origen"><span class="of-fecha-desde">Sale de</span> {{ opcion.salida }}</span>
            <span class="of-fecha-fecha">{{ opcion.fecha }}</span>
            {% if opcion.nota %}<span class="of-fecha-salida">{{ opcion.nota }}</span>{% endif %}
            {% if opcion.link %}<a href="{{ opcion.link }}" class="btn btn-borde of-fecha-ir" target="_blank" rel="noopener sponsored">Ver el vuelo<span class="solo-lectores"> desde {{ opcion.salida }} en {{ proveedor }} (se abre en una pestaña nueva)</span></a>{% endif %}
            {% if opcion.link_hotel %}<a href="{{ opcion.link_hotel }}" class="btn btn-borde of-fecha-ir" target="_blank" rel="noopener sponsored">Ver el hotel<span class="solo-lectores"> de {{ opcion.salida }} en {{ proveedor_hotel }} (se abre en una pestaña nueva)</span></a>{% endif %}
            {% endif %}
          </span>
          <span class="of-fecha-precio">{{ opcion.precio }}{% if opcion == barata and validas.length > 1 %}<em>La más barata</em>{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="of-sujeto">Aún sin fechas con precio. Pulsa «Ver oferta» para consultarlo.</p>
      {% endif %}
      <p class="of-sujeto">El precio puede haber cambiado. Confírmalo al reservar.</p>
      {% if consejo_reserva %}<p class="of-consejo"><strong>En esta oferta:</strong> {{ consejo_reserva }}</p>{% endif %}
      {% if link_hotel %}<p class="of-sujeto"><strong>Son dos reservas distintas:</strong> primero el vuelo y después el hotel. No pagas en La Maleta Lista.</p>{% endif %}
      {% if not (not esHotel and conLink.length > 1) %}
      <a href="{{ enlace }}" class="btn btn-coral of-cta" target="_blank" rel="noopener sponsored">{% if link_hotel %}Ver el vuelo en {{ proveedor }}{% else %}Ver oferta{% endif %}<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
      {% endif %}
      {% if link_hotel and not conHotel.length %}<a href="{{ link_hotel }}" class="btn btn-borde of-cta of-cta-hotel" target="_blank" rel="noopener sponsored">Ver el hotel en {{ proveedor_hotel }}<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>{% endif %}
      <a href="#of-pasos" class="btn btn-borde of-cta of-cta-hotel">Cómo reservar</a>
    </section>

    {% if hotelBase and otras_fechas and otras_fechas.length %}
    <section aria-labelledby="of-otras-fechas" id="of-otras-wrap">
      <h2 id="of-otras-fechas">{% if link_hotel %}Otras fechas (vuelo + hotel){% else %}Otras fechas{% endif %}</h2>
      <p class="of-pasos-intro">{% if link_hotel %}Cada fecha lleva el vuelo y el hotel que te propongo.{% else %}Mismo hotel, otras noches.{% endif %}</p>
      <ul class="of-otras-fechas">
        {% for f in otras_fechas %}
        {% if f.vuelo %}
        <li class="con-vuelo" data-desde="{{ f.desde }}">
          <p class="of-ov-cab"><strong>{{ f.desde | fechaCorta }} – {{ f.hasta | fechaCorta }}</strong><span class="of-otras-precio">{{ f.precio }}</span></p>
          <p class="of-ov-linea"><b>Vuelo directo</b> {{ f.vuelo }}</p>
          <p class="of-ov-linea"><b>Hotel</b> {{ nombre_hotel }}</p>
          <div class="of-ov-botones">
            <a class="btn btn-coral" href="{{ link_afiliado.split('?')[0] }}?sub_id={{ f.sub }}" target="_blank" rel="noopener sponsored">Ver el vuelo<span class="solo-lectores"> en {{ proveedor }} (se abre en una pestaña nueva)</span></a>
            <a class="btn btn-borde" href="{{ hotelBase | fechasTrivago(f.desde, f.hasta) }}" target="_blank" rel="noopener sponsored">Ver el hotel<span class="solo-lectores"> en {{ proveedor_hotel }} (se abre en una pestaña nueva)</span></a>
          </div>
        </li>
        {% else %}
        <li data-desde="{{ f.desde }}"><a href="{{ hotelBase | fechasTrivago(f.desde, f.hasta) }}" target="_blank" rel="noopener sponsored"><span>{{ f.desde | fechaCorta }} – {{ f.hasta | fechaCorta }}</span><span class="of-otras-precio">{% if f.precio %}{{ f.precio }}{% else %}Ver precio{% endif %}</span><span class="solo-lectores"> (se abre en una pestaña nueva)</span></a></li>
        {% endif %}
        {% endfor %}
      </ul>
      {% if otras_fechas_nota %}<p class="of-sujeto">{{ otras_fechas_nota }}</p>{% endif %}
      {% if link_hotel %}<p class="of-sujeto">En {{ proveedor }} busca esas fechas y elige el vuelo con esos horarios.</p>{% endif %}
    </section>
    {% endif %}

    {% if hotelBase and ("dr-" in hotelBase) %}
    <section class="of-buscar" aria-labelledby="of-buscar" id="buscar-fechas" data-base="{{ hotelBase }}">
      <h2 id="of-buscar">{% if link_hotel %}¿Otra fecha para el hotel?{% else %}¿Otra fecha distinta?{% endif %}</h2>
      <p class="of-pasos-intro">Elige tus noches y mira el precio.</p>
      <div class="of-buscar-campos">
        <label for="bf-entrada">Entrada<input type="date" id="bf-entrada"></label>
        <label for="bf-salida">Salida<input type="date" id="bf-salida"></label>
      </div>
      <a class="btn btn-coral" id="bf-ir" href="{{ hotelBase }}" target="_blank" rel="noopener sponsored">Ver precio en Trivago<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
      <p class="of-sujeto" id="bf-aviso" role="status" hidden></p>
    </section>
    {% endif %}

    {% if not esHotel %}
    <section aria-labelledby="of-otras">
      <h2 id="of-otras">¿Otras fechas u otro origen?</h2>
      <p class="of-pasos-intro">Busca vuelos desde tu ciudad y para tus fechas.</p>
      <button type="button" class="btn btn-borde" id="widget-abrir" aria-expanded="false" aria-controls="widget-vuelos">Abrir el buscador de vuelos</button>
      <div class="of-widget" id="widget-vuelos" hidden></div>
      <p class="of-afiliado">Carga el buscador de Skyscanner, con sus propias cookies.</p>
    </section>
    {% endif %}

    {% if content %}
    <section class="of-info" aria-labelledby="of-info">
      <h2 id="of-info">Sobre la oferta</h2>
      <div>{{ content | safe }}</div>
    </section>
    {% endif %}

    <section aria-labelledby="of-pasos">
      <h2 id="of-pasos">Cómo reservar</h2>
      <p class="of-pasos-intro">Reservas en la web{% if proveedor %} de {{ proveedor }}{% else %} del proveedor{% endif %}. Aquí solo te llevo hasta allí.</p>
      <ol class="of-pasos">
        <li>
          <strong>{% if link_hotel %}Pulsa «Ver el vuelo» y «Ver el hotel»{% else %}Pulsa «Ver oferta»{% endif %}</strong>
          <span>{% if link_hotel %}Se abren {{ proveedor }} y {{ proveedor_hotel }}. Se reservan por separado.{% else %}Se abre{% if proveedor %} {{ proveedor }}{% else %} la web de reserva{% endif %} en otra pestaña.{% endif %}</span>
        </li>
        <li>
          <strong>Pon tus fechas y personas</strong>
          <span>Si las tuyas son otras, cámbialas y pulsa Buscar.</span>
        </li>
        <li>
          <strong>Revisa y reserva allí</strong>
          <span>Mira precio final, desayuno y cancelación. Pagas y te confirma el proveedor.</span>
        </li>
      </ol>
      <p class="of-sujeto">¿Primera vez? <a href="/guia/reservar-vuelo-y-hotel-por-separado/">Guía paso a paso para reservar vuelo y hotel</a>.</p>
    </section>

    <details class="of-mas">
      <summary>Completa tu viaje</summary>
      <ul>
        {% if afiliados.seguroActivo %}
        <li><a href="{{ afiliados.seguro | utmLink(destino) }}" target="_blank" rel="noopener sponsored">Seguro de viaje<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a></li>
        {% endif %}
        <li><a href="{{ afiliados.coche | utmLink(destino) }}" target="_blank" rel="noopener sponsored">Alquiler de coche<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a></li>
        <li><a href="{{ civitatis_url | civitatisUrl(destino) }}" target="_blank" rel="noopener sponsored">Actividades en {{ destino }}<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a></li>
      </ul>
    </details>

    <p class="of-aviso-afiliado">Enlaces de afiliado: si reservas, puedo recibir una comisión sin coste para ti.</p>
  </div>

  <div class="of-barra">
    <div class="of-barra-interior">
      <p class="of-barra-precio">
        {% if precio_barra %}
        <span>{% if validas.length > 1 %}Desde{% else %}Precio{% endif %}</span>
        <strong>{{ precio_barra.precio | precioCorto }}</strong>
        {% if precio_barra.precio | precioUnidad %}<small>{{ precio_barra.precio | precioUnidad }}</small>{% endif %}
        {% else %}
        <span>Consulta el precio</span>
        {% endif %}
      </p>
      {% if link_hotel %}
      <div class="of-barra-botones">
        <a href="{{ enlace }}" class="btn btn-coral" target="_blank" rel="noopener sponsored">Vuelo<span class="solo-lectores"> en {{ proveedor }} (se abre en una pestaña nueva)</span></a>
        <a href="{{ link_hotel }}" class="btn btn-borde" target="_blank" rel="noopener sponsored">Hotel<span class="solo-lectores"> en {{ proveedor_hotel }} (se abre en una pestaña nueva)</span></a>
      </div>
      {% else %}
      <a href="{{ enlace }}" class="btn btn-coral" target="_blank" rel="noopener sponsored">Ver oferta<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
      {% endif %}
    </div>
  </div>
</article>

<script>
(function () {
  // Fechas pasadas: se ocultan al abrir la página, sin esperar a que se reconstruya la web.
  var hoy = new Date(); hoy.setHours(0, 0, 0, 0);
  var pasada = function (iso) { return iso && new Date(iso + 'T23:59:59') < hoy; };
  var alternativas = document.querySelectorAll('[data-desde]');
  var vivas = 0;
  alternativas.forEach(function (li) {
    if (new Date(li.dataset.desde + 'T00:00:00') < hoy) li.hidden = true; else vivas++;
  });
  var wrap = document.getElementById('of-otras-wrap');
  if (wrap && alternativas.length && !vivas) wrap.hidden = true;
  var art = document.querySelector('.of[data-caduca]');
  if (art && pasada(art.dataset.caduca)) {
    var aviso = document.getElementById('of-finalizada');
    if (aviso) aviso.hidden = false;
    document.querySelectorAll('.of-cta, .of-fecha-ir, .of-barra, .of-ov-botones').forEach(function (el) { el.hidden = true; });
    var fechas = document.querySelector('.of-fechas');
    if (fechas) fechas.hidden = true;
    if (wrap) wrap.hidden = true;
  }
})();
(function () {
  var p = document.querySelector('[data-fecha]');
  if (p) {
    var inicioHoy = new Date(); inicioHoy.setHours(0, 0, 0, 0);
    var dias = Math.round((inicioHoy.getTime() - new Date(p.dataset.fecha + 'T00:00:00').getTime()) / 86400000);
    var hace = p.querySelector('.hace');
    if (hace && !isNaN(dias) && dias >= 0) {
      hace.textContent = dias === 0 ? ' (hoy)' : dias === 1 ? ' (hace 1 día)' : ' (hace ' + dias + ' días)';
    }
  }
  var barra = document.querySelector('.of-barra');
  var cta = document.querySelector('.of-cta');
  if (barra && cta) {
    var revisarBarra = function () {
      var r = cta.getBoundingClientRect();
      barra.classList.toggle('oculta', r.top < window.innerHeight && r.bottom > 0);
    };
    window.addEventListener('scroll', revisarBarra, { passive: true });
    window.addEventListener('resize', revisarBarra);
    revisarBarra();
  }
  var visor = document.getElementById('visor');
  if (visor && visor.showModal) {
    var fotos = Array.prototype.slice.call(document.querySelectorAll('.of-foto'));
    var visorImg = document.getElementById('visor-img');
    var actual = 0;
    var mostrar = function (i) {
      actual = (i + fotos.length) % fotos.length;
      visorImg.src = fotos[actual].dataset.grande;
      visorImg.alt = fotos[actual].querySelector('img').alt;
    };
    fotos.forEach(function (b, i) {
      b.addEventListener('click', function () { mostrar(i); visor.showModal(); });
    });
    document.getElementById('visor-cerrar').addEventListener('click', function () { visor.close(); });
    document.getElementById('visor-ant').addEventListener('click', function () { mostrar(actual - 1); });
    document.getElementById('visor-sig').addEventListener('click', function () { mostrar(actual + 1); });
    visor.addEventListener('click', function (e) { if (e.target === visor) visor.close(); });
  }
  var tira = document.querySelector('.of-galeria');
  if (tira) {
    var gAnt = document.getElementById('gal-ant');
    var gSig = document.getElementById('gal-sig');
    var estadoTira = function () {
      var max = tira.scrollWidth - tira.clientWidth;
      gAnt.hidden = tira.scrollLeft < 8;
      gSig.hidden = max < 8 || tira.scrollLeft > max - 8;
    };
    var mover = function (dir) { tira.scrollBy({ left: dir * Math.max(170, tira.clientWidth * 0.8), behavior: 'smooth' }); };
    gAnt.addEventListener('click', function () { mover(-1); });
    gSig.addEventListener('click', function () { mover(1); });
    tira.addEventListener('scroll', estadoTira, { passive: true });
    window.addEventListener('resize', estadoTira);
    estadoTira();
  }
  var buscar = document.getElementById('buscar-fechas');
  if (buscar) {
    var base = buscar.dataset.base;
    var ent = document.getElementById('bf-entrada');
    var sal = document.getElementById('bf-salida');
    var ir = document.getElementById('bf-ir');
    var aviso = document.getElementById('bf-aviso');
    var f = /dr-(\d{4})(\d{2})(\d{2})-(\d{4})(\d{2})(\d{2})/.exec(base);
    var hoy = new Date();
    var iso = function (d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); };
    ent.min = iso(hoy);
    if (f) { ent.value = f[1] + '-' + f[2] + '-' + f[3]; sal.value = f[4] + '-' + f[5] + '-' + f[6]; }
    var actualizar = function () {
      var ok = ent.value && sal.value && sal.value > ent.value;
      if (ent.value) {
        var d = new Date(ent.value + 'T12:00:00');
        d.setDate(d.getDate() + 1);
        sal.min = iso(d);
      }
      ir.setAttribute('aria-disabled', ok ? 'false' : 'true');
      ir.classList.toggle('desactivado', !ok);
      aviso.hidden = ok;
      aviso.textContent = ok ? '' : 'Elige una fecha de salida posterior a la de entrada.';
      if (ok) ir.href = base.replace(/dr-\d{8}-\d{8}/, 'dr-' + ent.value.replace(/-/g, '') + '-' + sal.value.replace(/-/g, ''));
    };
    ent.addEventListener('change', function () {
      if (ent.value && (!sal.value || sal.value <= ent.value)) {
        var d = new Date(ent.value + 'T12:00:00');
        d.setDate(d.getDate() + 1);
        sal.value = iso(d);
      }
      actualizar();
    });
    sal.addEventListener('change', actualizar);
    ir.addEventListener('click', function (e) { if (ir.getAttribute('aria-disabled') === 'true') e.preventDefault(); });
    actualizar();
  }
  var abrir = document.getElementById('widget-abrir');
  var contenedor = document.getElementById('widget-vuelos');
  if (abrir && contenedor) {
    abrir.addEventListener('click', function () {
      if (!contenedor.hasChildNodes()) {
        var w = document.createElement('div');
        w.setAttribute('data-skyscanner-widget', 'FlightSearchWidget');
        w.setAttribute('data-locale', 'es-ES');
        w.setAttribute('data-market', 'ES');
        w.setAttribute('data-currency', 'EUR');
        w.setAttribute('data-associate-id', 'AFF_TRA_19354_00001');
        w.setAttribute('data-utm-term', '{{ page.fileSlug | replace("-", "") }}');
        w.setAttribute('data-hide-powered-by', 'true');
        w.setAttribute('data-button-colour', '#E9502D');
        w.setAttribute('data-responsive', 'true');
        w.setAttribute('data-flights-cabin-classes', 'false');
        w.setAttribute('data-direct-flights-is-checked', 'true');
        w.setAttribute('data-flight-type', 'return');
        contenedor.appendChild(w);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://widgets.skyscanner.net/widget-server/js/loader.js';
        contenedor.appendChild(s);
      }
      var visible = contenedor.hidden;
      contenedor.hidden = !visible;
      abrir.setAttribute('aria-expanded', visible ? 'true' : 'false');
      abrir.textContent = visible ? 'Cerrar el buscador' : 'Abrir el buscador de vuelos';
    });
  }
  var btn = document.getElementById('compartir');
  var estado = document.getElementById('compartir-estado');
  if (!btn) return;
  if (!navigator.share && !(navigator.clipboard && navigator.clipboard.writeText)) return;
  btn.hidden = false;
  function avisar(texto) {
    estado.textContent = texto;
    setTimeout(function () { estado.textContent = ''; }, 2500);
  }
  btn.addEventListener('click', function () {
    var datos = { title: document.title, url: location.href };
    if (navigator.share) { navigator.share(datos).catch(function () {}); return; }
    navigator.clipboard.writeText(location.href).then(function () {
      avisar('Enlace copiado');
    }).catch(function () {
      avisar('No se pudo copiar el enlace');
    });
  });
})();
</script>
