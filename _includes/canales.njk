{#- Botón "Recibe el próximo chollo". Variables: canalClase (clases del botón), canalTexto, canalTg (enlace de Telegram). Con site.whatsappCanal vacío es solo Telegram. -#}
{% if site.whatsappCanal %}
<details class="canales">
  <summary class="{{ canalClase }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.9 4.1 18.7 19.2c-.24 1.06-.87 1.32-1.76.82l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9-8.13c.39-.35-.09-.54-.6-.19L6.37 12.9 1.58 11.4c-1.04-.33-1.06-1.04.22-1.54L20.5 2.6c.87-.32 1.63.2 1.4 1.5Z"/></svg>{{ canalTexto }}<span class="solo-lectores"> (elige Telegram o WhatsApp)</span></summary>
  <div class="canales-menu">
    <a href="{{ canalTg }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.9 4.1 18.7 19.2c-.24 1.06-.87 1.32-1.76.82l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9-8.13c.39-.35-.09-.54-.6-.19L6.37 12.9 1.58 11.4c-1.04-.33-1.06-1.04.22-1.54L20.5 2.6c.87-.32 1.63.2 1.4 1.5Z"/></svg>Telegram<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
    <a href="{{ site.whatsappCanal }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-2.5.7.7-2.4-.2-.3A8 8 0 0 1 12 4Z"/></svg>WhatsApp<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
  </div>
</details>
{% else %}
<a href="{{ canalTg }}" class="{{ canalClase }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.9 4.1 18.7 19.2c-.24 1.06-.87 1.32-1.76.82l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9-8.13c.39-.35-.09-.54-.6-.19L6.37 12.9 1.58 11.4c-1.04-.33-1.06-1.04.22-1.54L20.5 2.6c.87-.32 1.63.2 1.4 1.5Z"/></svg>{{ canalTexto }}<span class="solo-lectores"> en Telegram (se abre en una pestaña nueva)</span></a>
{% endif %}
