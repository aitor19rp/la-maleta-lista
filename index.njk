---
layout: layout.njk
title: La Maleta Lista — Chollos de vuelos y escapadas desde España
bodyClass: home
---
{% set ofertasOrdenadas = collections.ofertas | reverse %}
{% set ultima = ofertasOrdenadas | first %}
{% set ultimaOpcion = (ultima.data.opciones | opcionesValidas) | first %}
{% set ultimaEsHotel = (ultima.data.tipo == "hotel") or (not ultima.data.tipo and ultimaOpcion and ("Hotel" in ultimaOpcion.salida)) %}

<section class="portada">
  <div class="portada-foto" style="background-image: url('/img/hero-viajes.jpg');" role="img" aria-label="Ala de un avión al amanecer vista desde la ventanilla"></div>
  <div class="portada-contenido">
    <div class="portada-texto">
      <h1>Precios que parecen un error.</h1>
      <p class="portada-sub">Un chollo de vuelo o escapada desde España cada día. Compruebo el precio a mano antes de publicarlo.</p>
      <div class="portada-acciones">
        <a href="#chollos" class="btn btn-coral">Ver los chollos</a>
        <a href="#buscar" class="btn btn-fantasma">Buscar otro destino</a>
        <a href="{{ site.telegram }}" class="btn btn-fantasma" target="_blank" rel="noopener">Unirme al canal de Telegram<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
        <a href="https://wa.me/{{ site.whatsapp }}?text={{ "Hola, tengo una pregunta sobre un chollo" | urlencode }}" class="btn btn-fantasma" target="_blank" rel="noopener">Escríbeme por WhatsApp<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
      </div>
    </div>

    {% if ultima and ofertasOrdenadas.length > 1 %}
    <a href="{{ ultima.url }}" class="ultimo" aria-label="Último chollo: {{ ultima.data.destino }}">
      <span class="ultimo-etiqueta">Último chollo publicado</span>
      <span class="ultimo-foto">{% imagen ultima.data.imagen_cabecera, "", "96px", [96, 192], false %}</span>
      <span class="ultimo-datos">
        <span class="ultimo-destino">{{ ultima.data.destino }}</span>
        {% if ultima.data.subtitulo %}<span class="ultimo-sub">{{ ultima.data.subtitulo }}</span>{% endif %}
        {% if ultimaOpcion %}<span class="ultimo-fecha">{% if ultimaEsHotel %}Solo hotel{% else %}Sale de {{ ultimaOpcion.salida }}{% endif %} · {{ ultimaOpcion.fecha }}</span>{% endif %}
      </span>
      <span class="ultimo-comprobado" data-fecha="{{ ultima.date.toISOString() | truncate(10, true, '') }}">Publicado el {{ ultima.data.precio_verificado }}<b class="hace"></b></span>
      {% if ultimaOpcion %}<span class="ultimo-precio">{{ ultimaOpcion.precio | precioCorto }}</span>{% endif %}
    </a>
    {% endif %}
  </div>
</section>

<section class="confianza" aria-label="Cómo trabajo">
  <ul>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <strong>Precio comprobado</strong>
      <span>Con fecha, en cada oferta</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-7-6 16-3-7z"/></svg>
      <strong>Desde España</strong>
      <span>Vuelos y escapadas que salen de aquí</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
      <strong>Todo a la vista</strong>
      <span>Fechas, aerolínea y qué incluye</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12l18-8-3 17-6-5-3 4v-6z"/></svg>
      <strong>Aviso en Telegram</strong>
      <span>En cuanto sale uno nuevo</span>
    </li>
  </ul>
</section>

<section class="chollos" id="chollos">
  <div class="chollos-cabecera">
    <h2>Chollos activos</h2>
    <div class="filtros" id="filtros" role="group" aria-label="Filtrar por ciudad de salida" hidden></div>
  </div>

  {% if not ultima %}
  <div class="chollos-vacio">
    <p>Ahora mismo no hay chollos activos. Únete al canal de Telegram y te aviso en cuanto salga el siguiente.</p>
    <a href="{{ site.telegram }}" class="btn" target="_blank" rel="noopener">Unirme a Telegram<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
  </div>
  {% endif %}

  <ul class="chollos-lista{% if ofertasOrdenadas.length < 3 %} pocas{% endif %}" id="chollos-lista">
    {% for oferta in ofertasOrdenadas %}
    {% set opciones = oferta.data.opciones | opcionesValidas %}
    {% set primera = opciones | first %}
    {% set esHotel = (oferta.data.tipo == "hotel") or (not oferta.data.tipo and primera and ("Hotel" in primera.salida)) %}
    <li class="chollo" data-salidas="{% if not esHotel %}{% for o in opciones %}{% if "Hotel" not in o.salida %}{{ o.salida }}|{% endif %}{% endfor %}{% endif %}">
      <a href="{{ oferta.url }}">
        <span class="chollo-foto" style="view-transition-name: foto-{{ oferta.fileSlug }};">
          {% imagen oferta.data.imagen_cabecera, "", "(min-width: 1040px) 360px, (min-width: 720px) 50vw, 100vw", [400, 800], false %}
          {% if primera %}<span class="chollo-precio">{{ primera.precio | precioCorto }}</span>{% endif %}
        </span>
        <span class="chollo-cuerpo">
          <span class="chollo-destino">{{ oferta.data.destino }}</span>
          {% if oferta.data.subtitulo %}<span class="chollo-sub">{{ oferta.data.subtitulo }}</span>{% endif %}
          {% if primera %}
          <span class="chollo-datos">{% if esHotel %}Solo hotel{% else %}Sale de {{ primera.salida }}{% endif %} · {{ primera.fecha }}{% if opciones.length > 1 %} <em>+{{ opciones.length - 1 }} salida{% if opciones.length > 2 %}s{% endif %}</em>{% endif %}</span>
          {% endif %}
          <span class="chollo-comprobado" data-fecha="{{ oferta.date.toISOString() | truncate(10, true, '') }}">Publicado el {{ oferta.data.precio_verificado }}<b class="hace"></b></span>
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="buscar" id="buscar" aria-labelledby="buscar-titulo">
  <h2 id="buscar-titulo">¿Buscas otro destino u otras fechas?</h2>
  <p class="buscar-intro">Si ningún chollo te encaja, busca tú mismo. Pones el destino y las fechas que quieras y comparas precios.</p>
  <div class="buscar-tarjetas">
    <div class="buscar-tarjeta">
      <h3>Vuelos</h3>
      <p>Busca vuelos desde tu ciudad con el buscador de Kiwi.com.</p>
      <button type="button" class="btn btn-coral" id="widget-abrir" aria-expanded="false" aria-controls="widget-kiwi">Abrir el buscador de vuelos</button>
      <div class="of-widget" id="widget-kiwi" hidden></div>
      <a class="buscar-enlace" href="{{ afiliados.kiwi }}" target="_blank" rel="noopener sponsored">O ve directamente a Kiwi.com<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
    </div>
    <div class="buscar-tarjeta">
      <h3>Hoteles</h3>
      <p>Compara el precio de un mismo hotel en Booking y otras webs con Trivago.</p>
      <a class="btn btn-borde" href="{{ afiliados.trivago }}" target="_blank" rel="noopener sponsored">Buscar hotel en Trivago<span class="solo-lectores"> (se abre en una pestaña nueva)</span></a>
    </div>
  </div>
  <p class="buscar-nota">Al abrir el buscador de vuelos se carga Kiwi.com, que puede usar sus propias cookies. Son enlaces de afiliado: puedo recibir una comisión sin coste extra para ti.</p>
</section>

<section class="metodo">
  <div class="metodo-interior">
    <div class="metodo-texto">
      <h2>Cada chollo se comprueba antes de publicarlo</h2>
      <p>Miro el precio, la aerolínea y el alojamiento en la web de reserva. Si el precio cambia, lo que cuenta es la fecha de comprobación que ves en cada oferta.</p>
      <p class="metodo-nota">Si reservas desde mis enlaces puedo recibir una comisión. A ti no te cuesta nada más.</p>
    </div>
    <ol class="metodo-pasos">
      <li><strong>Ves el chollo</strong> en un vídeo o aquí en la web.</li>
      <li><strong>Abres la oferta</strong> y revisas fechas, precio y qué incluye.</li>
      <li><strong>Reservas</strong> en la web del proveedor, con su precio final.</li>
    </ol>
  </div>
</section>

<script>
(function () {
  document.querySelectorAll('[data-fecha]').forEach(function (el) {
    var d = new Date(el.dataset.fecha + 'T12:00:00');
    var dias = Math.floor((Date.now() - d.getTime()) / 86400000);
    var hace = el.querySelector('.hace');
    if (!hace || isNaN(dias) || dias < 0) return;
    hace.textContent = dias === 0 ? ' (hoy)' : dias === 1 ? ' (hace 1 día)' : ' (hace ' + dias + ' días)';
  });
})();
(function () {
  var cont = document.getElementById('filtros');
  var items = Array.prototype.slice.call(document.querySelectorAll('#chollos-lista .chollo'));
  if (!cont || !items.length) return;
  var ciudades = [];
  items.forEach(function (li) {
    li.dataset.salidas.split('|').forEach(function (c) {
      if (c && ciudades.indexOf(c) === -1) ciudades.push(c);
    });
  });
  if (ciudades.length < 2) return;
  var lista = document.getElementById('chollos-lista');
  function pintar(activa, animar) {
    if (animar) {
      lista.classList.remove('filtrando');
      void lista.offsetWidth;
      lista.classList.add('filtrando');
      setTimeout(function () { lista.classList.remove('filtrando'); }, 400);
    }
    items.forEach(function (li) {
      var ok = !activa || li.dataset.salidas.split('|').indexOf(activa) !== -1;
      li.hidden = !ok;
    });
    Array.prototype.forEach.call(cont.children, function (b) {
      b.setAttribute('aria-pressed', String((b.dataset.ciudad || '') === (activa || '')));
    });
  }
  [''].concat(ciudades).forEach(function (c) {
    var b = document.createElement('button');
    b.type = 'button';
    b.textContent = c || 'Todas';
    b.dataset.ciudad = c;
    b.addEventListener('click', function () { pintar(c, true); });
    cont.appendChild(b);
  });
  cont.hidden = false;
  pintar('');
})();
(function () {
  var abrir = document.getElementById('widget-abrir');
  var contenedor = document.getElementById('widget-kiwi');
  if (!abrir || !contenedor) return;
  abrir.addEventListener('click', function () {
    if (!contenedor.hasChildNodes()) {
      var s = document.createElement('script');
      s.async = true;
      s.charset = 'utf-8';
      s.src = 'https://tpemb.com/content?currency=eur&trs=588032&shmarker=772596.widget-portada&locale=es&stops=0&show_hotels=true&powered_by=true&border_radius=0&plain=true&color_button=%231B4B66ff&color_button_text=%23ffffff&promo_id=3414&campaign_id=111';
      contenedor.appendChild(s);
    }
    var visible = contenedor.hidden;
    contenedor.hidden = !visible;
    abrir.setAttribute('aria-expanded', visible ? 'true' : 'false');
    abrir.textContent = visible ? 'Cerrar el buscador' : 'Abrir el buscador de vuelos';
  });
})();
</script>
